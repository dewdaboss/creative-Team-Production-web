# ------------------------------------------------------------------
# Creative Team Production — environment configuration
# Copy to .env.local and adjust. The site works with defaults too.
# ------------------------------------------------------------------

# ---- Admin panel (owner login at /admin) ----
ADMIN_USER=admin
ADMIN_PASS=ctp-admin-2024
# Long random string used to sign admin session cookies — CHANGE THIS
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars

# ---- Lead automation (Google Apps Script Web App) ----
# One endpoint: appends the lead to your Google Sheet AND emails the owner.
# Setup guide: AUTOMATION.md · ready-to-paste script: docs/google-apps-script.gs
NOTIFY_WEBHOOK_URL=
NOTIFY_EMAIL=you@yourdomain.com

# ---- Public contact / social (exposed to the browser) ----
NEXT_PUBLIC_SITE_NAME=Creative Team Production
NEXT_PUBLIC_CONTACT_PHONE=+91 97555 50380
NEXT_PUBLIC_WHATSAPP_NUMBER=919755550380
NEXT_PUBLIC_CONTACT_EMAIL=hello@creativeteam.production
NEXT_PUBLIC_ADDRESS=Studio 12, Film City Road, New Delhi 110001, India
NEXT_PUBLIC_MAPS_QUERY=Film City, Noida, India
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/creative_team_production_
NEXT_PUBLIC_YOUTUBE_URL=https://youtube.com/@creativeteamproduction
NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/profile.php?id=61588991206692
